# Text files are stored with LF in the repository and checked out with LF on
# every platform, so rustfmt, prettier and diffs agree regardless of the
# contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows batch files need CRLF to run reliably.
*.bat text eol=crlf

# Binary assets: never touch line endings or try to diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.icc binary
*.icm binary
*.tif binary
*.tiff binary
*.dng binary
*.jxl binary
*.exr binary
*.onnx binary
*.ort binary
*.bin binary
*.jar binary
*.so binary
*.dll binary
*.dylib binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
